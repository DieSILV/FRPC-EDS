[Unit]
Description=FRPC-EDS - panel de control
After=network-online.target frps.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=frp
Group=frp
WorkingDirectory=/opt/frpc-eds
EnvironmentFile=/opt/frpc-eds/.env
# Ajusta la ruta si Node está instalado en otro sitio (which node)
ExecStart=/usr/bin/node /opt/frpc-eds/src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
