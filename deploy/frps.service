[Unit]
Description=FRPC-EDS - servidor FRP (frps)
Documentation=https://gofrp.org
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=frp
Group=frp
WorkingDirectory=/opt/frpc-eds/data/runtime
ExecStart=/opt/frpc-eds/bin/frp/frps -c /opt/frpc-eds/data/runtime/frps.toml
Restart=always
RestartSec=3

# Permite escuchar en 80/443 sin ejecutar como root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
