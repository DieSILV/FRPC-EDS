# ==================================================================
# FRPC-EDS - Caddyfile  (dominio base: nexus-pro.pe)
#
# Caddy termina TLS y reenvía a frps (vhost HTTP) en 127.0.0.1:8080.
# Deja frps escuchando el vhost SOLO en localhost:
#   proxyBindAddr = "127.0.0.1"
# y vhostHTTPPort = 8080 en la pestaña «Servidor» del panel.
#
# Ruta: /etc/caddy/Caddyfile   →   systemctl reload caddy
# ==================================================================

{
	email tu-correo@ejemplo.com
}

# ------------------------------------------------------------------
# OPCIÓN A (recomendada): certificado wildcard *.nexus-pro.pe
# Requiere Caddy compilado con el plugin DNS de DigitalOcean:
#   xcaddy build --with github.com/caddy-dns/digitalocean
# y la variable de entorno DO_AUTH_TOKEN (token de DO con permiso
# read/write sobre los registros DNS de la zona nexus-pro.pe).
#
# DNS necesario en DigitalOcean:
#   A  *   →  137.184.226.242    (túneles)
#   A  @   →  167.172.133.217    (web principal; el wildcard NO cubre el apex)
# ------------------------------------------------------------------

*.nexus-pro.pe, nexus-pro.pe {
	tls {
		dns digitalocean {env.DO_AUTH_TOKEN}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}

# Panel de control en central.nexus-pro.pe (lo cubre el propio wildcard).
# Es más específico que el wildcard, así que Caddy lo prioriza.
central.nexus-pro.pe {
	tls {
		dns digitalocean {env.DO_AUTH_TOKEN}
	}
	reverse_proxy 127.0.0.1:7800
}

# ------------------------------------------------------------------
# OPCIÓN B (sin plugins): certificado por subdominio bajo demanda.
# Caddy pide un certificado la primera vez que alguien visita
# <sub>.nexus-pro.pe y solo si el panel confirma que el túnel existe
# (endpoint /api/tls/ask). Comenta la Opción A y descomenta esto.
# ------------------------------------------------------------------
#
# {
# 	email tu-correo@ejemplo.com
# 	on_demand_tls {
# 		ask http://127.0.0.1:7800/api/tls/ask
# 	}
# }
#
# http:// {
# 	redir https://{host}{uri} permanent
# }
#
# :443 {
# 	tls {
# 		on_demand
# 	}
# 	reverse_proxy 127.0.0.1:8080 {
# 		flush_interval -1
# 	}
# }
