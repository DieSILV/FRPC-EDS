# ==================================================================
# FRPC-EDS - Caddyfile  (dominio base: nexus-pro.pe)
#
# Equivale a la configuración del droplet en producción.
# Caddy termina TLS y reenvía a frps (vhost HTTP) en 127.0.0.1:8080.
#
#   https://central.nexus-pro.pe         -> panel :7800
#   https://<sub>.nexus-pro.pe           -> túnel :8080
#   https://<sub>.nexus-pro.pe:<puerto>  -> túnel :8080 (Host reescrito)
#
# TLS: bajo demanda (HTTP-01). Caddy pide el certificado la primera vez que
# alguien visita un subdominio y solo si el panel lo autoriza
# (GET /api/tls/ask). No necesita plugins ni token de DigitalOcean.
#
# Listas blancas/negras: en cada petición Caddy consulta al panel
# (forward_auth -> GET /api/guard). 2xx = permitir, 403 = bloquear.
#
# Ruta: /etc/caddy/Caddyfile   →   systemctl reload caddy
# ==================================================================

{
	email tu-correo@ejemplo.com

	# Solo TCP (h1/h2). Evita que el navegador intente QUIC por UDP 443,
	# que en muchas redes se descarta y provoca "Failed to fetch".
	servers {
		protocols h1 h2
	}

	on_demand_tls {
		ask http://127.0.0.1:7800/api/tls/ask
	}
}

# ------------------------------------------------------------------
# Panel de control
# ------------------------------------------------------------------
central.nexus-pro.pe {
	log {
		output stderr
		format console
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:7800 {
		flush_interval -1
	}
}

# ------------------------------------------------------------------
# Túneles de clientes — https://<sub>.nexus-pro.pe
# ------------------------------------------------------------------
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	forward_auth 127.0.0.1:7800 {
		uri /api/guard
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port 443
		flush_interval -1
	}
}

# ------------------------------------------------------------------
# Puertos públicos adicionales por túnel: https://<host>:<puerto>
# El Host se reescribe a "p<puerto>-<host>" para que frps lo enrute al
# proxy correcto; hostHeaderRewrite devuelve al servicio el Host real.
# Deben coincidir con SUPPORTED_PUBLIC_PORTS (src/store.js).
# ------------------------------------------------------------------
https://:3000 {
	tls {
		on_demand
	}
	encode zstd gzip
	forward_auth 127.0.0.1:7800 {
		uri /api/guard
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up Host p3000-{http.request.host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port 3000
		flush_interval -1
	}
}

https://:3001 {
	tls {
		on_demand
	}
	encode zstd gzip
	forward_auth 127.0.0.1:7800 {
		uri /api/guard
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up Host p3001-{http.request.host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port 3001
		flush_interval -1
	}
}

https://:4173 {
	tls {
		on_demand
	}
	encode zstd gzip
	forward_auth 127.0.0.1:7800 {
		uri /api/guard
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up Host p4173-{http.request.host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port 4173
		flush_interval -1
	}
}

https://:5173 {
	tls {
		on_demand
	}
	encode zstd gzip
	forward_auth 127.0.0.1:7800 {
		uri /api/guard
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up Host p5173-{http.request.host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port 5173
		flush_interval -1
	}
}

# HTTP → HTTPS
http:// {
	redir https://{host}{uri} permanent
}
