# ------------------------------------------------------------------
# Panel FRPC-EDS
# Copia este archivo como .env y ajusta los valores.
# ------------------------------------------------------------------

# Interfaz y puerto donde escucha el panel.
# Usa 0.0.0.0 si quieres acceder desde otra máquina (protégelo con TLS).
PANEL_HOST=127.0.0.1
PANEL_PORT=7800

# Credenciales de acceso al panel (cámbialas siempre).
PANEL_USER=admin
PANEL_PASSWORD=cambia-esta-clave

# Secreto para firmar la cookie de sesión.
# Si lo dejas vacío se genera uno aleatorio en data/.session-secret
SESSION_SECRET=

# Duración de la sesión en horas.
SESSION_HOURS=12

# Ruta explícita al binario frpc (opcional, por defecto bin/frp/frpc[.exe]).
FRPC_PATH=
