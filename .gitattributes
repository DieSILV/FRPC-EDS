# Normaliza saltos de línea: el proyecto se despliega en Linux
* text=auto

*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.service text eol=lf
*.toml text eol=lf
Caddyfile text eol=lf
*.conf text eol=lf

# PowerShell funciona mejor con CRLF en Windows
*.ps1  text eol=crlf
*.bat  text eol=crlf
